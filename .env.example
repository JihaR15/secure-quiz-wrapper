# Postgres connection string, required on serverless hosts such as Vercel
# because their filesystem is read-only and does not persist between requests.
#
# Supabase: Project Settings -> Database -> Connection string.
# Use the "Session pooler" (port 5432) URI, or append ?sslmode=require.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-AP-REGION.pooler.supabase.com:5432/postgres"

# Optional. Max connections per warm serverless instance. Supabase's free tier
# is generous with the session pooler, but many concurrent lambdas add up.
DATABASE_POOL_MAX=2

# Secret for the admin session cookie (HS256, 7 day expiry).
# Generate one with: openssl rand -base64 48
JWT_SECRET="change-me"
